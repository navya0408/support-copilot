# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.

# Free key from https://aistudio.google.com  ("Get API key")
GEMINI_API_KEY=

# Model id. "gemini-flash-latest" is an alias that follows Google's current Flash model.
# If you get a "model not found" or quota error, copy an exact free-tier model id from AI Studio.
GEMINI_MODEL=gemini-flash-latest

# Backup model(s), comma-separated, used if the main model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Give up on one Gemini call after this many seconds
LLM_TIMEOUT_SECONDS=20

# Retrieval: number of chunks, and the max cosine DISTANCE to still answer (lower = stricter).
# Tune MAX_DISTANCE with:  python -m eval.run_eval
TOP_K=3
MAX_DISTANCE=0.60

# Classifier confidence below this shows "check the category manually" (chosen with ml/confidence_analysis.py)
LOW_CLASSIFIER_CONFIDENCE=0.50

# Public-demo protections (0 = off):
RATE_LIMIT_PER_MINUTE=20      # requests per minute per visitor address
MAX_LLM_CALLS_PER_DAY=200     # total LLM calls per day; after that the app shows the top passage instead

# Privacy: false = feedback stores only a short hash and lengths, not the ticket or draft text
STORE_TICKET_TEXT=false

# Comma-separated list of pages allowed to call this API. When you deploy, put your real frontend URL here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
